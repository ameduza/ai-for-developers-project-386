{
  "name": "calendar-booking",
  "version": "1.0.0",
  "description": "Sandbox meeting booking project built with power of AI",
  "homepage": "https://github.com/ameduza/ai-for-developers-project-386#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ameduza/ai-for-developers-project-386.git"
  },
  "author": "ameduza",
  "type": "module",
  "workspaces": [
    "typespec",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build:contract": "npm run build:contract --workspace typespec",
    "test": "npm run test:release-config && npm run test:e2e-ci-config && npm run test --workspaces --if-present",
    "test:e2e": "playwright test --config e2e/playwright.config.mjs",
    "test:e2e-ci-config": "node --test scripts/e2e-ci-config.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "check:release-config": "node scripts/check-release-config.mjs",
    "test:release-config": "node --test scripts/check-release-config.test.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "client/**/*.{ts,tsx}": [
      "npm run lint:staged --workspace client --",
      "npm run format:staged --workspace client --"
    ],
    "server/**/*.ts": [
      "npm run lint:staged --workspace server --",
      "npm run format:staged --workspace server --"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "yaml": "^2.9.0"
  }
}
